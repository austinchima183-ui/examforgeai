# ============================================================================
# ExamForge AI — Terraform Variables Template
# ============================================================================
# Copy to terraform.tfvars and fill in actual values.
# NEVER commit terraform.tfvars to version control.
# ============================================================================

environment = "staging"

# Supabase
supabase_project_id   = "your-project-id"
supabase_access_token = "your-access-token"
supabase_db_password  = "your-db-password"

# Flutterwave
flutterwave_secret_key   = "your-flutterwave-secret-key"
flutterwave_webhook_hash = "your-webhook-hash"

# AWS
aws_region     = "af-south-1"
dr_aws_region  = "eu-west-1"

# S3
backup_bucket_name = "examforge-backups"
dr_bucket_name     = "examforge-backups-dr"

# Domain
app_domain = "examforge.ai"

# Webhook IP allowlist (Flutterwave IPs)
allowed_webhook_ips = [
  "44.234.108.128/25",
  "34.210.54.0/24"
]
