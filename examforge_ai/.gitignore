# ============================================================================
# ExamForge AI — .gitignore (Hardened)
# ============================================================================
# Ensures no secrets, credentials, or sensitive files are committed.
# ============================================================================

# ─── Environment & Secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
gpg-backup-keys/

# ─── Build Artifacts ──────────────────────────────────────────────────────
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.tar.gz
*.zip
.packages
.pub-cache/
.pub/

# ─── IDE & OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ─── Coverage & Reports ──────────────────────────────────────────────────
coverage/
test_results.json
*.lcov

# ─── Database ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
db/

# ─── Backups ──────────────────────────────────────────────────────────────
backups/
*.sql
*.sql.gz
*.sql.gpg
*.dump

# ─── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ─── Node.js ──────────────────────────────────────────────────────────────
node_modules/
.next/
out/

# ─── Terraform State (CRITICAL — contains secrets) ───────────────────────
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.tfplan

# ─── Deployment ───────────────────────────────────────────────────────────
deploy/
*.version.txt

# ─── Temporary Files ──────────────────────────────────────────────────────
tmp/
temp/
*.swp
*.swo
*~

# ─── Agent Context (internal) ─────────────────────────────────────────────
agent-ctx/
tool-results/
