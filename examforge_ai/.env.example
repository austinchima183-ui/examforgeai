# ──────────────────────────────────────────────────────────────
# ExamForge AI — Environment Configuration Template
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────

# Supabase — Project URL and API keys from your Supabase dashboard
# Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# NOTE: SUPABASE_SERVICE_KEY must ONLY be set in Supabase Edge Function
# environment variables. It must NEVER appear in the client-side .env file.

# Flutterwave — Payment gateway keys
# Flutterwave Dashboard → Settings → API Keys
FLUTTERWAVE_PUBLIC_KEY=<your-flutterwave-public-key>

# NOTE: FLUTTERWAVE_SECRET_KEY and FLUTTERWAVE_WEBHOOK_SECRET_HASH
# must ONLY be set in Supabase Edge Function environment variables.
# They must NEVER appear in the client-side .env file.

# Application environment: development | staging | production
ENVIRONMENT=development
